# ─── Localhost-only SaaS testing (http://localhost:3000) ─────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LOCALHOST_ONLY=true

# Supabase (hosted project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auth → URL Configuration (dashboard)
# Site URL: http://localhost:3000
# Redirect URLs:
#   http://localhost:3000/**
#   http://localhost:3000/auth/callback

# Razorpay — Pro ₹999/month INR. Run: npm run billing:setup-plan
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-test-secret
RAZORPAY_PLAN_ID=plan_SqiAXCnlihQwhE
# Webhooks optional locally — /api/billing/verify activates Pro after checkout.
# RAZORPAY_WEBHOOK_SECRET=
# ENABLE_RAZORPAY_WEBHOOKS=true

GEMINI_API_KEY=your-gemini-key
RESEND_API_KEY=
EMAIL_FROM=Recalliq <onboarding@resend.dev>
