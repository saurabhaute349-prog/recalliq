# Copy to .env.local for development.
# Production: set NEXT_PUBLIC_APP_URL to your live origin (e.g. https://app.recalliq.ai).
# Do NOT set NEXT_PUBLIC_LOCALHOST_ONLY=true in production.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LOCALHOST_ONLY=true

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Must match: same key id on server and client
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-test-secret
RAZORPAY_PLAN_ID=plan_xxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

GEMINI_API_KEY=your-gemini-key
RESEND_API_KEY=
EMAIL_FROM=Recalliq <onboarding@resend.dev>

# Analytics (optional — PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Monitoring (optional — Sentry)
NEXT_PUBLIC_SENTRY_DSN=

# Development only: set ENABLE_RAZORPAY_WEBHOOKS=true to test webhooks locally
# ENABLE_RAZORPAY_WEBHOOKS=true
